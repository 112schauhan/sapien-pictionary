{
  "name": "sapien-pictionary",
  "version": "1.0.0",
  "description": "Real-time multiplayer pictionary (Skribbl-style) in the browser",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "concurrently -n server,client -c teal,magenta \"npm run backend\" \"npm run frontend\"",
    "backend": "node scripts/run-backend.js",
    "frontend": "npm --prefix client run dev -- --host 127.0.0.1 --port 5173",
    "test": "echo \"No automated tests yet\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/112schauhan/sapien-pictionary.git"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
